{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "other",
  "buildCommand": "npm run build",
  "installCommand": "npm install",
  "outputDirectory": ".",
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/projects",
      "destination": "/projects.html"
    },
    {
      "source": "/project-truffle",
      "destination": "/project-truffle.html"
    },
    {
      "source": "/project-moveit",
      "destination": "/project-moveit.html"
    },
    {
      "source": "/project-schultz-studios",
      "destination": "/project-schultz-studios.html"
    }
  ]
}
