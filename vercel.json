{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "routes": [
    {
      "src": "^/$",
      "dest": "/index.html"
    },
    {
      "src": "^/projects/?$",
      "dest": "/projects.html"
    },
    {
      "src": "^/project-truffle/?$",
      "dest": "/project-truffle.html"
    },
    {
      "src": "^/project-moveit/?$",
      "dest": "/project-moveit.html"
    },
    {
      "src": "^/project-schultz-studios/?$",
      "dest": "/project-schultz-studios.html"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
